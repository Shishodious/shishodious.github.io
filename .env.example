# Hide a service from the live site without deleting its code: set its flag
# to "false" and it drops out of the chooser, the nav pill and its own route
# (a direct link to it falls back to "/"). Unset, or set to anything else,
# means shown — a missing env var never hides a page by accident.
#
# Copy this file to .env.local for local overrides (gitignored), or set
# these as build-time environment variables on your host.
#
# This repo deploys to GitHub Pages via .github/workflows/deploy.yml, which
# reads these from the repo's Actions variables (Settings -> Secrets and
# variables -> Actions -> Variables), not from any .env file — a .env.local
# or a host-side (e.g. Vercel) env var has no effect on that build. Update
# them with `gh variable set VITE_SHOW_BRAND --body false`, or in the
# Settings UI.

VITE_SHOW_VIDEO=true
VITE_SHOW_BRAND=true
VITE_SHOW_APPS=true

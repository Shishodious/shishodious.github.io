# Hide a service from the live site without deleting its code: set its flag
# to "false" and it drops out of the chooser, the nav pill and its own route
# (a direct link to it falls back to "/"). Unset, or set to anything else,
# means shown — a missing env var never hides a page by accident.
#
# Copy this file to .env.local for local overrides (gitignored), or set
# these as build-time environment variables on your host (e.g. GitHub Pages
# repo/environment secrets, or your host's project settings).

VITE_SHOW_VIDEO=true
VITE_SHOW_CONTENT=true
VITE_SHOW_BRAND=true
VITE_SHOW_APPS=true
